# Copy this file to `.env` and fill in your key(s). `.env` is gitignored.
#
# DEV ONLY. These are read by the Vite dev server so you can run the app in a
# browser without the desktop keychain. In the packaged desktop app, keys are
# entered in Settings and stored in the OS credential manager instead — the
# build deliberately does NOT bundle anything from here (enforced by
# scripts/check-bundle-secrets.mjs).

# Required. Get one at https://aistudio.google.com -> "Get API key".
# IMPORTANT: enable billing on the key. The free tier cannot finish one
# interview (it makes a grading call per answer plus a parse and a report).
GEMINI_API_KEY=

# Optional. Alternative text provider (voice via the fallback pipeline).
XAI_API_KEY=

# Optional. Text-to-speech for text-only providers.
ELEVENLABS_API_KEY=
